# ==========================================
# Sistem Manajemen Operasional & Transaksi CV. ANDARA
# Environment Configuration Template
# Copy this file to .env for local development
# NEVER commit real credentials to version control
# ==========================================

# Database (PostgreSQL)
POSTGRES_DB=andara_erp
POSTGRES_USER=andara_user
POSTGRES_PASSWORD=andara_dev_password_123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/andara_erp
DATABASE_USERNAME=andara_user
DATABASE_PASSWORD=andara_dev_password_123

# Security / Session
SESSION_TIMEOUT_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudflare R2 Storage (Optional for initial local dev, required for attachments)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=andara-attachments-dev
R2_PUBLIC_DOMAIN=

# Monitoring & Error Reporting (Optional)
SENTRY_DSN=

# Frontend Application
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_TITLE="CV. ANDARA - Sistem Manajemen Keuangan"
