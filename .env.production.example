# ==========================================================
# Sistem Manajemen Operasional & Transaksi CV. ANDARA
# Production Environment Variables (.env.production)
# Copy this file to .env on the production VPS server
# STRICT REQUIREMENT: NEVER commit real passwords to Git
# ==========================================================

# 1. Domain & Networking
APP_DOMAIN=https://andara.co.id
HTTP_PORT=80

# 2. Database Credentials (PostgreSQL Container)
POSTGRES_DB=andara_erp
POSTGRES_USER=andara_prod_user
# Generate strong 32+ character random password: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PRODUCTION_SECRET

# 3. File Storage (Cloudflare R2 Bucket: andara-files)
STORAGE_TYPE=r2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY=YOUR_CLOUDFLARE_R2_ACCESS_KEY
R2_SECRET_KEY=YOUR_CLOUDFLARE_R2_SECRET_KEY
R2_BUCKET_NAME=andara-files
R2_REGION=auto

# 4. Database Backup Storage (Cloudflare R2 Bucket: andara-backups)
BACKUP_R2_BUCKET=andara-backups
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=3

# 5. Monitoring (Free Tiers)
# UptimeRobot URL endpoint: https://andara.co.id/actuator/health
SENTRY_DSN=
