# ==========================================================
# Sistem Manajemen Operasional & Transaksi CV. ANDARA
# Production Environment Variables
#
# INSTRUKSI:
#   1. Copy file ini ke server: scp .env.production.example root@202.155.14.98:/opt/andara-erp/.env
#   2. Edit di server: nano /opt/andara-erp/.env
#   3. Isi semua nilai yang belum diisi
#
# PERINGATAN:
#   ❌ JANGAN commit file .env ke Git
#   ❌ JANGAN share isi file ini di chat / email
#   ✅ Simpan backup di password manager (Bitwarden, 1Password, dll)
# ==========================================================

# --- 1. Domain & Networking ---
APP_DOMAIN=https://cvandaraerp.web.id
HTTP_PORT=80
HTTPS_PORT=443

# --- 2. Database Credentials (PostgreSQL) ---
POSTGRES_DB=andara_erp
POSTGRES_USER=andara_prod_user
# Generate password kuat: openssl rand -base64 32
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_MINIMAL_32_KARAKTER

# --- 3. File Storage — Cloudflare R2 (bucket: andara-files) ---
STORAGE_TYPE=r2
R2_ENDPOINT=https://0eebb682d31f9b4eab50353ae3f38ff1.r2.cloudflarestorage.com
R2_ACCESS_KEY=GANTI_DENGAN_R2_ACCESS_KEY_BARU
R2_SECRET_KEY=GANTI_DENGAN_R2_SECRET_KEY_BARU
R2_BUCKET_NAME=andara-files
R2_REGION=auto

# --- 4. Database Backup Storage — Cloudflare R2 (bucket: andara-backups) ---
BACKUP_R2_BUCKET=andara-backups
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=3

# --- 5. Cloudflare ---
CF_ZONE_ID=be7f99482a87a9b958c29de679e927bf
CF_API_TOKEN=GANTI_DENGAN_CF_API_TOKEN_BARU

# --- 6. Monitoring ---
# UptimeRobot: monitor URL https://cvandaraerp.web.id/actuator/health (interval 5 menit)
# Sentry: buat project di sentry.io → salin DSN ke bawah ini
SENTRY_DSN=

# --- 7. Server Info (referensi, tidak dipakai oleh aplikasi) ---
# VPS    : Cloud VPS Lite 2GB — Domainesia Jakarta
# IPv4   : 202.155.14.98
# IPv6   : 2001:df7:5300:18::5e8
# OS     : Ubuntu 22.04 LTS
# SSH    : ssh root@202.155.14.98
